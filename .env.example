# OpenCode Ephemeral Orchestrator Configuration

PORT=8080
HOST=0.0.0.0

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opencode
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=opencode
# PGSSL=false

# Ephemeral Sandbox Base Directory (Mount to tmpfs or emptyDir in Kubernetes)
SANDBOX_BASE_DIR=/tmp/sandboxes

# OpenCode CLI Binary Path
OPENCODE_BIN_PATH=opencode

# Context Rehydration Settings
DEFAULT_CONTEXT_TURNS=10

# Timeout Durations (milliseconds)
PROCESS_TIMEOUT_MS=300000
INTERACTION_TIMEOUT_MS=300000
